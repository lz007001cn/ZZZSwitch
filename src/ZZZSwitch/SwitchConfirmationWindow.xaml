<Window x:Class="ZZZSwitch.SwitchConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="620"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="确认切换服务器"
                   FontSize="21"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,14,0,0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="SourceProfileImage"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           Margin="0,0,12,0">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8" />
                        </Image.Clip>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前服务器"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="SourceProfileText"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="→"
                           FontSize="21"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image x:Name="TargetProfileImage"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           Margin="0,0,12,0">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8" />
                        </Image.Clip>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="目标服务器"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TargetProfileText"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0,10,0,0"
                Padding="16">
            <Grid x:Name="DetailGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="游戏版本" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock x:Name="GameVersionText" Grid.Column="1" />

                <TextBlock Grid.Row="1" Text="文件操作" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock x:Name="FileOperationText" Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="2" Text="回滚备份" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock x:Name="BackupPathText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    Width="92"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Width="108"
                    Content="确认切换"
                    IsDefault="True"
                    Click="Confirm_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
