<Window x:Class="ZZZSwitch.BackupLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZSwitch · 备份目录"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="备份目录" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="管理事务备份的存储位置"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="当前备份目录"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="BackupPathTextBox"
                         IsReadOnly="True"
                         Margin="0,9,0,0"
                         TextWrapping="NoWrap" />
                <TextBlock x:Name="LocationModeText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="UsageText"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="打开目录"
                    Click="OpenLocation_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="更改位置"
                    Click="ChangeLocation_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    x:Name="RestoreDefaultButton"
                    Content="恢复默认位置"
                    Click="RestoreDefault_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="4"
                    Content="关闭"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
