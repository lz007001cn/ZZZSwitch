<Window x:Class="ZZZSwitch.BackupLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Text="{DynamicResource L.BackupLocation.Title}" FontSize="22" FontWeight="SemiBold" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.BackupLocation.CurrentDirectory}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="BackupPathTextBox"
                         IsReadOnly="True"
                         Margin="0,9,0,0"
                         TextWrapping="NoWrap" />
                <TextBlock x:Name="LocationModeText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="UsageText"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Content="{DynamicResource L.Common.OpenFolder}"
                    Click="OpenLocation_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    x:Name="ChangeLocationButton"
                    Content="{DynamicResource L.Common.ChangeLocation}"
                    Click="ChangeLocation_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    x:Name="RestoreDefaultButton"
                    Content="{DynamicResource L.Common.RestoreDefault}"
                    Click="RestoreDefault_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="4"
                    x:Name="CloseButton"
                    Content="{DynamicResource L.Common.Close}"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
