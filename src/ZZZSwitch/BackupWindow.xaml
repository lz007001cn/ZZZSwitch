<Window x:Class="ZZZSwitch.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="920" Height="500"
        MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource L.Backup.Title}"
                   Margin="0,0,0,14"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="1">
            <DataGrid x:Name="BackupsGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource RaisedSurfaceBrush}"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="Transparent"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Time}" Binding="{Binding Time}" Width="155" />
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Source}" Binding="{Binding Source}" Width="105" />
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Target}" Binding="{Binding Target}" Width="105" />
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Result}" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Restored}" Binding="{Binding Restored}" Width="155" />
                    <DataGridTextColumn Header="{DynamicResource L.Backup.Directory}" Binding="{Binding Path}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource L.Common.Refresh}"
                    Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button x:Name="RestoreLatestButton"
                    Content="{DynamicResource L.Backup.RestoreLatest}"
                    Click="RestoreLatest_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C88A3A"
                    BorderBrush="#C88A3A"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Backup.RestoreSelected}"
                    Click="Restore_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C88A3A"
                    BorderBrush="#C88A3A"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Backup.DeleteSelected}"
                    Click="Delete_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C65359"
                    BorderBrush="#C65359"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Common.Close}"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
