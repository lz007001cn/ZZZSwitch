<Window x:Class="ZZZSwitch.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZSwitch · 备份历史"
        Width="920" Height="500"
        MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="备份历史" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="可以恢复或删除已完成的事务备份"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="1">
            <DataGrid x:Name="BackupsGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource RaisedSurfaceBrush}"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="Transparent"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="155" />
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="105" />
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="105" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="恢复时间" Binding="{Binding Restored}" Width="155" />
                    <DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="刷新"
                    Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button x:Name="RestoreLatestButton"
                    Content="恢复上次状态"
                    Click="RestoreLatest_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C88A3A"
                    BorderBrush="#C88A3A"
                    Margin="0,0,8,0" />
            <Button Content="恢复选中备份"
                    Click="Restore_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C88A3A"
                    BorderBrush="#C88A3A"
                    Margin="0,0,8,0" />
            <Button Content="删除选中备份"
                    Click="Delete_Click"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#C65359"
                    BorderBrush="#C65359"
                    Margin="0,0,8,0" />
            <Button Content="关闭"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
