<Window x:Class="ZZZSwitch.ThemedMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZSwitch"
        Width="500"
        SizeToContent="Height"
        MaxHeight="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="{DynamicResource RaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <Ellipse x:Name="ToneDot"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource NeutralBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,18,0,0"
                Padding="16">
            <ScrollViewer MaxHeight="390"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           LineHeight="21"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Width="88"
                    Visibility="Collapsed"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button x:Name="PrimaryButton"
                    MinWidth="96"
                    IsDefault="True"
                    Click="Primary_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
