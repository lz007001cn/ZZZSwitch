<Window x:Class="ZZZSwitch.OnlineDifferenceDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="700"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid x:Name="DownloadRootGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="{DynamicResource L.Download.Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DirectionText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="SummaryCard"
                Style="{StaticResource CardStyle}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Download.Files}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="FileCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource L.Download.Maximum}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="DownloadSizeText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource L.Download.Integrity}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="IntegrityText"
                               Text="{DynamicResource L.Download.AutomaticVerification}"
                               Margin="0,6,0,0"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="PercentText"
                               DockPanel.Dock="Right"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                </DockPanel>
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Margin="0,10,0,0" />
                <TextBlock x:Name="CurrentFileText"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="DetailText"
                           Margin="0,5,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,9,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource L.Common.Cancel}"
                    Width="92"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button x:Name="StartButton"
                    Content="{DynamicResource L.Download.Start}"
                    Width="112"
                    IsDefault="True"
                    Click="Start_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
