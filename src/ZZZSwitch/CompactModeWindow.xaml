<Window x:Class="ZZZSwitch.CompactModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZZZSwitch.Controls"
        Title="ZZZSwitch"
        Width="620"
        Height="180"
        MinWidth="620"
        MinHeight="180"
        MaxWidth="620"
        MaxHeight="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ZZZSwitch-Icon.png"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Grid x:Name="CompactLayoutRoot" Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="14" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ServerSwitchCard x:Name="CompactGlobalButton"
                                       IsCompact="True"
                                       ServerName="{DynamicResource L.Server.Global}"
                                       IconSource="Assets/Server-Global.png"
                                       Command="{Binding SwitchGlobalCommand}"
                                       IsCurrent="{Binding IsGlobalActive}"
                                       AccentBrush="{DynamicResource GlobalProfileBrush}"
                                       Margin="0,0,5,0" />
            <controls:ServerSwitchCard Grid.Column="1"
                                       x:Name="CompactCnButton"
                                       IsCompact="True"
                                       ServerName="{DynamicResource L.Server.Cn}"
                                       IconSource="Assets/Server-CN.png"
                                       Command="{Binding SwitchCnCommand}"
                                       IsCurrent="{Binding IsCnActive}"
                                       AccentBrush="{DynamicResource CnProfileBrush}"
                                       Margin="5,0" />
            <controls:ServerSwitchCard Grid.Column="2"
                                       x:Name="CompactBilibiliButton"
                                       IsCompact="True"
                                       ServerName="{DynamicResource L.Server.Bilibili}"
                                       IconSource="Assets/Server-Bilibili.png"
                                       Command="{Binding SwitchBilibiliCommand}"
                                       IsCurrent="{Binding IsBilibiliActive}"
                                       AccentBrush="{DynamicResource BilibiliProfileBrush}"
                                       Margin="5,0,0,0" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="CompactOperationStatus"
                  Margin="2,0,16,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding ShowCompactStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CompactStatusText"
                           Text="{Binding BusyStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Row="1"
                             x:Name="CompactOperationProgress"
                             Height="2"
                             Minimum="0"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Margin="0,6,0,0" />
            </Grid>

            <Button Grid.Column="1"
                    x:Name="FullModeButton"
                    Click="FullMode_Click"
                    Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{DynamicResource L.Compact.FullMode}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
