<Window x:Class="ZZZSwitch.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="640"
        Height="460"
        MinWidth="600"
        MinHeight="430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeadingText"
                       Text="{DynamicResource L.Onboarding.Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       x:Name="StepText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StepOneIndicator" Height="3" Background="{DynamicResource TextBrush}" />
            <Border x:Name="StepTwoIndicator" Grid.Column="2" Height="3" Background="{DynamicResource BorderBrush}" />
            <Border x:Name="StepThreeIndicator" Grid.Column="4" Height="3" Background="{DynamicResource BorderBrush}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <StackPanel x:Name="AppearancePanel">
                <TextBlock Text="{DynamicResource L.Onboarding.Appearance}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource L.Settings.Language}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ComboBox Grid.Column="1"
                              x:Name="LanguageComboBox"
                              SelectionChanged="Appearance_SelectionChanged" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource L.Settings.Theme}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ComboBox Grid.Column="1"
                              x:Name="ThemeComboBox"
                              SelectionChanged="Appearance_SelectionChanged" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="GameDirectoryPanel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Onboarding.GameDirectory}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <TextBlock Text="{DynamicResource L.Onboarding.Path}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GamePathTextBox"
                             VerticalContentAlignment="Center"
                             TextChanged="GamePath_TextChanged" />
                    <Button Grid.Column="1"
                            x:Name="DetectButton"
                            Content="{DynamicResource L.Onboarding.Detect}"
                            Click="Detect_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,6,0" />
                    <Button Grid.Column="2"
                            x:Name="BrowseButton"
                            Content="{DynamicResource L.Common.Browse}"
                            Click="Browse_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <TextBlock x:Name="DirectoryStatusText"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource L.Onboarding.Behavior}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <TextBlock Text="{DynamicResource L.Onboarding.StartMode}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FullModeRadio"
                                 Content="{DynamicResource L.Onboarding.FullMode}"
                                 GroupName="StartMode"
                                 Margin="0,0,28,0" />
                    <RadioButton x:Name="CompactModeRadio"
                                 Content="{DynamicResource L.Onboarding.CompactMode}"
                                 GroupName="StartMode" />
                </StackPanel>
                <TextBlock Text="{DynamicResource L.Onboarding.CloseBehavior}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,22,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CloseToTrayRadio"
                                 Content="{DynamicResource L.Onboarding.CloseToTray}"
                                 GroupName="CloseBehavior"
                                 Margin="0,0,28,0" />
                    <RadioButton x:Name="ExitOnCloseRadio"
                                 Content="{DynamicResource L.Onboarding.ExitOnClose}"
                                 GroupName="CloseBehavior" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton"
                    Content="{DynamicResource L.Common.Cancel}"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    x:Name="BackButton"
                    Content="{DynamicResource L.Onboarding.Back}"
                    Click="Back_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    x:Name="NextButton"
                    Click="Next_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="96">
                <TextBlock x:Name="NextButtonText"
                           Text="{DynamicResource L.Onboarding.Next}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>
    </Grid>
</Window>
