<Window x:Class="ZZZSwitch.OnlineResourceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}"
        Title=""
        Width="920"
        Height="650"
        MinWidth="820"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel">
            <TextBlock x:Name="HeadingText"
                       Text="{DynamicResource L.Resources.Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="SummaryCard"
                Style="{StaticResource CardStyle}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Resources.PackageUsage}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="PackageBytesText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource L.Resources.SavedVersions}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="VersionCountText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource L.Resources.ManifestCache}"
                               ToolTip="{DynamicResource L.Resources.ManifestCacheTip}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="ManifestCacheText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button x:Name="RefreshButton"
                    Content="{DynamicResource L.Common.Refresh}"
                    Width="80"
                    Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Resources.RefreshTip}" />
            <Button x:Name="RefreshManifestButton"
                    Content="{DynamicResource L.Resources.UpdateManifest}"
                    Width="128"
                    Click="RefreshManifest_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Resources.UpdateManifestTip}" />
            <Button x:Name="BrowseManifestButton"
                    Content="{DynamicResource L.Resources.BrowseManifest}"
                    Width="116"
                    Click="BrowseManifest_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Resources.BrowseManifestTip}" />
            <Button x:Name="PreviewButton"
                    Content="{DynamicResource L.Resources.Preview}"
                    Width="108"
                    IsEnabled="False"
                    Click="Preview_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Resources.PreviewTip}" />
            <Button x:Name="VerifyButton"
                    Content="{DynamicResource L.Resources.Verify}"
                    Width="92"
                    IsEnabled="False"
                    Click="Verify_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    ToolTip="{DynamicResource L.Resources.VerifyTip}" />
            <Button x:Name="UpdatePackageButton"
                    Content="{DynamicResource L.Resources.UpdatePackage}"
                    Width="116"
                    IsEnabled="False"
                    Click="UpdatePackage_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="{DynamicResource L.Resources.UpdatePackageTip}" />
        </StackPanel>

        <ListBox Grid.Row="3"
                 x:Name="PackageList"
                 Margin="0,12,0,0"
                 Padding="1,0,2,0"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionChanged="PackageList_SelectionChanged"
                 MouseDoubleClick="PackageList_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SelectionBorder"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="1">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource StrongBorderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Resources.Version}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Version}" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource L.Resources.TargetClient}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Target}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource L.Resources.State}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding State}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{DynamicResource L.Resources.Size}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Size}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource L.Resources.Content}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Detail}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton"
                    Content="{DynamicResource L.Resources.OpenDirectory}"
                    Width="120"
                    IsEnabled="False"
                    Click="Open_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    x:Name="DeleteButton"
                    Content="{DynamicResource L.Resources.DeleteSelected}"
                    Width="120"
                    IsEnabled="False"
                    Click="Delete_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="3"
                    Content="{DynamicResource L.Common.Close}"
                    Width="92"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
