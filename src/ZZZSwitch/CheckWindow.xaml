<Window x:Class="ZZZSwitch.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource OverlayWindowStyle}" Width="740" Height="530" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Icon="Assets/ZZZSwitch-Icon.png"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource L.Check.Title}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource L.Check.Hint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
        <WrapPanel Grid.Row="2" x:Name="Actions" Margin="0,0,0,12">
            <Button x:Name="DetectButton" Content="{DynamicResource L.Check.Detect}" Tag="Detect" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
            <Button x:Name="RepairButton" Content="{DynamicResource L.Check.Repair}" Tag="Repair" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
            <Button x:Name="PackagesButton" Content="{DynamicResource L.Check.Packages}" Tag="Packages" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
            <Button x:Name="ResetButton" Content="{DynamicResource L.Check.Reset}" Tag="Reset" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
            <Button x:Name="RecoverButton" Content="{DynamicResource L.Check.Recover}" Tag="Recover" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
            <Button Content="{DynamicResource L.Check.Logs}" Tag="Logs" Click="Action_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
        </WrapPanel>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12">
            <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
        </Border>
        <Button Grid.Row="4" x:Name="CloseButton" Content="{DynamicResource L.Common.Close}" Click="Close_Click"
                HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
