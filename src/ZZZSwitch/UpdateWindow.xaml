<Window x:Class="ZZZSwitch.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource OverlayWindowStyle}" Width="680" Height="650" MinWidth="580" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="22" Background="{DynamicResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
  <ScrollViewer x:Name="UpdateScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock x:Name="CurrentVersionText" Margin="0,0,0,10"/>
    <TextBlock x:Name="EndpointLabel" Foreground="{DynamicResource MutedTextBrush}"/>
    <TextBox x:Name="EndpointBox" Margin="0,5,0,10"/>
    <WrapPanel Margin="0,0,0,12">
     <ComboBox x:Name="ChannelBox" Width="110" Margin="0,0,16,0"><ComboBoxItem Content="stable"/><ComboBoxItem Content="beta"/></ComboBox>
     <CheckBox x:Name="AutomaticBox" VerticalAlignment="Center"/>
    </WrapPanel>
    <Button x:Name="CheckButton" Click="Check_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
    <Border Style="{StaticResource CardStyle}" Padding="14">
     <StackPanel>
      <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock x:Name="DateText" Margin="0,5,0,8" Foreground="{DynamicResource MutedTextBrush}"/>
      <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,8"/>
    <ProgressBar x:Name="DownloadProgress" Height="7" Minimum="0" Maximum="100"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="DownloadButton" Click="Download_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Margin="0,0,10,0">
    <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Button.ContentTemplate>
   </Button>
   <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
  </StackPanel>
 </Grid>
</Window>
