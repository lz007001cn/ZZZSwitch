<Window x:Class="ZZZSwitch.CacheManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZSwitch · 缓存管理"
        Width="680"
        SizeToContent="Height"
        MaxHeight="680"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/ZZZSwitch-Icon.png"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="缓存管理"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="管理双服热更新缓存的位置与旧版本内容"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="当前缓存目录"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="CachePathTextBox"
                         IsReadOnly="True"
                         Margin="0,9,0,0"
                         TextWrapping="NoWrap" />
                <TextBlock x:Name="LocationModeText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="当前游戏缓存"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="TotalCacheText"
                               Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalFilesText"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="旧版本缓存"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ObsoleteCacheText"
                               Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ObsoleteVersionsText"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="更改位置"
                    Click="ChangeLocation_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    x:Name="RestoreDefaultButton"
                    Content="恢复默认位置"
                    Click="RestoreDefault_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    x:Name="DeleteObsoleteButton"
                    Content="清理旧版本缓存"
                    Click="DeleteObsolete_Click"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="8,0" />
            <Button Grid.Column="3"
                    Content="关闭"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
