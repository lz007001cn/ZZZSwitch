<UserControl x:Class="ZZZSwitch.Controls.InspectionSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Summary.CurrentClient}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ProfileAccent, TargetNullValue={StaticResource NeutralBrush}}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,9,0" />
                        <TextBlock Text="{Binding Profile}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource L.Summary.GameVersion}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" />
                    <TextBlock Text="{Binding GameVersion}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{DynamicResource L.Summary.Packages}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" />
                    <TextBlock Text="{Binding Packages}"
                               ToolTip="{Binding Packages}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Summary.Cache}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" />
                    <TextBlock Text="{Binding CacheSummary}"
                               ToolTip="{Binding CacheSummary}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               Margin="0,7,16,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="CacheManagementButton"
                        Content="{DynamicResource L.Summary.CacheManagement}"
                        Command="{Binding CacheManagementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanManageCache}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        x:Name="InitializeCacheButton"
                        Content="{DynamicResource L.Summary.InitializeCache}"
                        Command="{Binding InitializeCacheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanInitializeCache}"
                        VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
