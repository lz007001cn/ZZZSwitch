<UserControl x:Class="ZZZSwitch.Controls.ServerSwitchCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Grid>
        <Button x:Name="SwitchButton"
                Command="{Binding Command, ElementName=Root}"
                AutomationProperties.Name="{Binding ServerName, ElementName=Root}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SwitchButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="MinHeight" Value="68" />
                            <Setter Property="Padding" Value="14,8" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompact, ElementName=Root}" Value="True" />
                                <Condition Binding="{Binding IsCurrent, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{Binding AccentBrush, ElementName=Root}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48"
                        Height="48"
                        CornerRadius="10"
                        Background="Transparent"
                        BorderThickness="0"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image x:Name="ServerIcon"
                           Source="{Binding IconSource, ElementName=Root}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,48,48"
                                               RadiusX="9"
                                               RadiusY="9" />
                        </Image.Clip>
                    </Image>
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="13,0"
                           Text="{Binding ServerName, ElementName=Root}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           x:Name="StateIcon"
                           FontFamily="Segoe Fluent Icons"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE72A;" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent, ElementName=Root}" Value="True">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{Binding AccentBrush, ElementName=Root}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <Border x:Name="ActiveOutline"
                BorderBrush="{Binding AccentBrush, ElementName=Root}"
                BorderThickness="2"
                CornerRadius="7"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCompact, ElementName=Root}" Value="True" />
                                <Condition Binding="{Binding IsCurrent, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
