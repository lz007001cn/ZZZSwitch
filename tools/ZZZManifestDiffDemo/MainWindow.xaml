<Window x:Class="ZZZManifestDiffDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZZZManifestDiffDemo"
        Title="ZZZ Manifest Diff Demo"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#202020" />
            <Setter Property="HorizontalGridLinesBrush" Value="#303030" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1D1D1D" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30453F" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ZZZ Manifest Diff Demo"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Sophon snapshot 文件差异校验演示"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="LoadDemoButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="LoadDemo_Click"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE82D;"
                                   FontFamily="Segoe Fluent Icons"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="载入演示" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        x:Name="CompareButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Compare_Click"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe Fluent Icons"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="开始校验" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="来源 Manifest"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceMetaText"
                                   Text="未选择"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonStyle}"
                            Click="BrowseSource_Click"
                            ToolTip="选择来源 snapshot.json">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="选择" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               x:Name="SourcePathText"
                               Text="选择 ZZZSwitch ManifestCache 中的 snapshot.json"
                               Margin="0,10,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    x:Name="SwapButton"
                    Width="36"
                    Height="36"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Click="Swap_Click"
                    IsEnabled="False"
                    ToolTip="交换来源与目标">
                <TextBlock Text="&#xE8AB;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="15" />
            </Button>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="目标 Manifest"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="TargetMetaText"
                                   Text="未选择"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonStyle}"
                            Click="BrowseTarget_Click"
                            ToolTip="选择目标 snapshot.json">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="选择" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               x:Name="TargetPathText"
                               Text="选择 ZZZSwitch ManifestCache 中的 snapshot.json"
                               Margin="0,10,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="22,12,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Border Background="#25271F" BorderBrush="#4B452D" BorderThickness="1" CornerRadius="6" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="修改" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="ModifiedCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ModifiedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#1F2925" BorderBrush="#315045" BorderThickness="1" CornerRadius="6" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="新增" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="AddedCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AddedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#2A2020" BorderBrush="#563535" BorderThickness="1" CornerRadius="6" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="删除" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="RemovedCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RemovedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Background="#20232A" BorderBrush="#373F56" BorderThickness="1" CornerRadius="6" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="相同" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="SameCountText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SameBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="容量变化" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Grid.Row="1" x:Name="SizeDeltaText" Text="—" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="22,12,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Background="#161616" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllFilter" Content="全部" Tag="All" GroupName="Filters" Style="{StaticResource SegmentStyle}" IsChecked="True" Checked="Filter_Changed" />
                    <RadioButton Content="修改" Tag="Modified" GroupName="Filters" Style="{StaticResource SegmentStyle}" Checked="Filter_Changed" />
                    <RadioButton Content="新增" Tag="Added" GroupName="Filters" Style="{StaticResource SegmentStyle}" Checked="Filter_Changed" />
                    <RadioButton Content="删除" Tag="Removed" GroupName="Filters" Style="{StaticResource SegmentStyle}" Checked="Filter_Changed" />
                    <RadioButton Content="相同" Tag="Same" GroupName="Filters" Style="{StaticResource SegmentStyle}" Checked="Filter_Changed" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="1"
                       x:Name="VisibleCountText"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="0 项" />
            <Grid Grid.Column="2">
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           IsHitTestVisible="False" />
                <TextBox x:Name="SearchTextBox"
                         Padding="32,7,10,7"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="按文件路径或 MD5 搜索" />
            </Grid>
        </Grid>

        <DataGrid Grid.Row="4"
                  x:Name="DifferenceGrid"
                  Margin="22,0"
                  SelectionChanged="DifferenceGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="状态" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="7,3" CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#303030" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:DifferenceState.Modified}">
                                                <Setter Property="Background" Value="#51452B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:DifferenceState.Added}">
                                                <Setter Property="Background" Value="#29483C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:DifferenceState.Removed}">
                                                <Setter Property="Background" Value="#503232" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:DifferenceState.Same}">
                                                <Setter Property="Background" Value="#343A4C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StateLabel}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="文件路径" Binding="{Binding Path}" Width="2.2*" />
                <DataGridTextColumn Header="来源大小" Binding="{Binding SourceSizeText}" Width="105" />
                <DataGridTextColumn Header="目标大小" Binding="{Binding TargetSizeText}" Width="105" />
                <DataGridTextColumn Header="变化" Binding="{Binding DeltaText}" Width="100" />
                <DataGridTextColumn Header="来源 MD5" Binding="{Binding SourceMd5}" Width="220" />
                <DataGridTextColumn Header="目标 MD5" Binding="{Binding TargetMd5}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5"
                Margin="22,8,22,16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="选择两个 Manifest，或载入内置演示。" />
                    <TextBlock x:Name="SelectedDetailText"
                               Margin="0,3,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="ExportButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="Export_Click"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;"
                                   FontFamily="Segoe Fluent Icons"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="导出报告" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
